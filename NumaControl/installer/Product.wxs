<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="NUMA Control" Language="1049" Codepage="1251" Version="$(var.ProductVersion)" Manufacturer="NUMA Control" UpgradeCode="5B491C32-5ADB-44C9-8E40-EA269B744AA9" Scope="perUser" InstallerVersion="500" ProductCode="$(var.ProductCode)"><SummaryInformation Description="NUMA Control — игровые профили CPU" Codepage="1251" />
    <MajorUpgrade DowngradeErrorMessage="Установлена более новая версия NUMA Control." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="INSTALLFOLDER" Secure="yes" /><Property Id="APPLICATIONMENUFOLDER" Secure="yes" /><Property Id="APPLICATIONDESKTOPFOLDER" Secure="yes" />
    <Property Id="PREVIOUSINSTALLFOLDER"><RegistrySearch Id="ExistingInstallFolder" Root="HKCU" Key="Software\NUMA Control\Installer" Name="InstallFolder" Type="raw" Bitness="always64" /></Property>
    <Property Id="PREVIOUSMENUFOLDER"><RegistrySearch Id="ExistingMenuFolder" Root="HKCU" Key="Software\NUMA Control\Installer" Name="MenuFolder" Type="raw" Bitness="always64" /></Property>
    <Property Id="PREVIOUSDESKTOPFOLDER"><RegistrySearch Id="ExistingDesktopFolder" Root="HKCU" Key="Software\NUMA Control\Installer" Name="DesktopFolder" Type="raw" Bitness="always64" /></Property>
    <SetProperty Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]" Before="CostFinalize" Condition="NOT INSTALLFOLDER AND PREVIOUSINSTALLFOLDER AND (Installed OR WIX_UPGRADE_DETECTED)" />
    <SetProperty Id="APPLICATIONMENUFOLDER" Value="[PREVIOUSMENUFOLDER]" Before="CostFinalize" Condition="NOT APPLICATIONMENUFOLDER AND PREVIOUSMENUFOLDER AND (Installed OR WIX_UPGRADE_DETECTED)" />
    <SetProperty Id="APPLICATIONDESKTOPFOLDER" Value="[PREVIOUSDESKTOPFOLDER]" Before="SetDesktopFolder" Condition="NOT APPLICATIONDESKTOPFOLDER AND PREVIOUSDESKTOPFOLDER AND (Installed OR WIX_UPGRADE_DETECTED)" />
    <Property Id="DESKTOPCHOICE" Secure="yes" />
    <Property Id="SAVEDDESKTOPCHOICE"><RegistrySearch Id="ExistingDesktopChoice" Root="HKCU" Key="Software\NUMA Control\Installer" Name="DesktopChoice" Type="raw" Bitness="always64" /></Property>
    <SetDirectory Id="DesktopFolder" Value="[APPLICATIONDESKTOPFOLDER]" Condition="APPLICATIONDESKTOPFOLDER" />
    <SetProperty Id="DESKTOPCHOICE" Value="[SAVEDDESKTOPCHOICE]" Before="CostFinalize" Action="RestoreDesktopChoice" Condition="NOT DESKTOPCHOICE AND SAVEDDESKTOPCHOICE" />
    <SetProperty Id="DESKTOPCHOICE" Value="0" After="RestoreDesktopChoice" Action="DefaultDesktopChoice" Condition="NOT DESKTOPCHOICE" />
    <SetProperty Id="DESKTOPCHECKBOX" Value="1" After="DefaultDesktopChoice" Sequence="ui" Condition="DESKTOPCHOICE = &quot;1&quot;" />
    <Property Id="NET48RELEASE"><RegistrySearch Id="FindNet48" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" Bitness="always64" /></Property>
    <Launch Condition="Installed OR (VersionNT64 AND NET48RELEASE &gt;= &quot;#528040&quot;)" Message="Требуются Windows x64 и .NET Framework 4.8 или новее." />
    <Launch Condition="NOT ALLUSERS" Message="NUMA Control устанавливается только для текущего пользователя." />
    <Icon Id="AppIcon" SourceFile="$(var.ProjectRoot)\src\app.ico" />

    <Feature Id="Complete" Title="NUMA Control" Level="1">
      <ComponentRef Id="MainExecutable" /><ComponentRef Id="RuntimeConfig" /><ComponentRef Id="Documentation" /><ComponentRef Id="MenuShortcuts" /><ComponentRef Id="StandaloneUninstallShortcut" /><ComponentRef Id="DesktopShortcut" />
    </Feature>
    <CustomAction Id="CleanOwnedShortcuts" ExeCommand="--uninstall-cleanup" Execute="immediate" Return="ignore" FileRef="ApplicationExe" />
    <InstallExecuteSequence>
      <Custom Action="CleanOwnedShortcuts" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <?ifdef InjectRollback ?>
      <InstallExecute After="InstallFiles" />
      <Custom Action="FailAfterFiles" After="InstallExecute" Condition="NOT Installed" />
      <?endif?>
    </InstallExecuteSequence>
    <?ifdef InjectRollback ?>
    <CustomAction Id="FailAfterFiles" Error="Injected rollback test" />
    <?endif?>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Dialog Id="DesktopOptionsDlg" Width="370" Height="270" Title="Установка NUMA Control">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="7" Width="300" Height="18" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Дополнительные параметры" />
        <Control Id="Hint" Type="Text" X="20" Y="65" Width="330" Height="32" Text="Выберите, нужен ли ярлык приложения на рабочем столе. Игровые ярлыки создаются отдельно в программе." />
        <Control Id="DesktopChoice" Type="CheckBox" X="20" Y="108" Width="330" Height="20" Property="DESKTOPCHECKBOX" CheckBoxValue="1" Text="Создать ярлык NUMA Control на рабочем столе" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Назад"><Publish Event="NewDialog" Value="InstallDirDlg" /></Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Далее"><Publish Property="DESKTOPCHOICE" Value="0" Order="1" Condition="NOT DESKTOPCHECKBOX" /><Publish Property="DESKTOPCHOICE" Value="1" Order="2" Condition="DESKTOPCHECKBOX" /><Publish Event="NewDialog" Value="VerifyReadyDlg" Order="3" /></Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Отмена"><Publish Event="SpawnDialog" Value="CancelDlg" /></Control>
      </Dialog>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="DesktopOptionsDlg" Order="5" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID = &quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="DesktopOptionsDlg" Order="5" Condition="NOT Installed" />
    </UI>
    <WixVariable Id="WixUIBannerBmp" Value="$(var.ProjectRoot)\installer\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.ProjectRoot)\installer\dialog.bmp" />

      <StandardDirectory Id="LocalAppDataFolder"><Directory Id="ProgramsFolder" Name="Programs"><Directory Id="INSTALLFOLDER" Name="NUMA Control">
        <Component Id="MainExecutable" Guid="A6C221A6-BF03-4A8E-95BE-BE0C1F8AEB48" Bitness="always64">
          <File Id="ApplicationExe" Name="NUMA-Control.exe" Source="$(var.ApplicationExe)" />
          <RegistryValue Root="HKCU" Key="Software\NUMA Control\Installer" Name="InstallFolder" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
          <RegistryValue Root="HKCU" Key="Software\NUMA Control\Installer" Name="DesktopFolder" Value="[DesktopFolder]" Type="string" />
          <RegistryValue Root="HKCU" Key="Software\NUMA Control\Installer" Name="DesktopChoice" Value="[DESKTOPCHOICE]" Type="string" />
          <RemoveFolder Id="RemoveEmptyInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
          <RemoveFolder Id="RemoveEmptyProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
        </Component>
        <Component Id="RuntimeConfig" Guid="D1EE48CC-530C-4AE9-A8C0-C331F31E2F95" Bitness="always64">
          <File Id="ApplicationConfig" Source="$(var.ProjectRoot)\NUMA-Control.exe.config" />
          <RegistryValue Root="HKCU" Key="Software\NUMA Control\Installer" Name="Config" Value="1" Type="integer" KeyPath="yes" />
        </Component>
        <Component Id="Documentation" Guid="671E21EE-D068-40B0-8B38-9ACFAFA3AAC9" Bitness="always64">
          <File Id="UserGuide" Source="$(var.ProjectRoot)\USER-GUIDE.md" />
          <File Id="UserGuideRu" Source="$(var.ProjectRoot)\USER-GUIDE.ru.md" />
          <File Id="Readme" Source="$(var.ProjectRoot)\README.md" />
          <File Id="ReadmeRu" Source="$(var.ProjectRoot)\README.ru.md" />
          <File Id="License" Name="LICENSE.txt" Source="$(var.ProjectRoot)\..\LICENSE" />
          <File Id="ThirdPartyNotices" Source="$(var.ProjectRoot)\..\THIRD-PARTY-NOTICES.txt" />
          <RegistryValue Root="HKCU" Key="Software\NUMA Control\Installer" Name="Docs" Value="1" Type="integer" KeyPath="yes" />
        </Component>
      </Directory></Directory></StandardDirectory>
      <StandardDirectory Id="ProgramMenuFolder"><Directory Id="APPLICATIONMENUFOLDER" Name="NUMA Control">
        <Component Id="MenuShortcuts" Guid="4C839BFA-EEBE-4E54-B30A-55D7F15248E1" Bitness="always64">
          <Shortcut Id="StartMenuLaunch" Name="NUMA Control" Target="[INSTALLFOLDER]NUMA-Control.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" Description="Игровые профили CPU" />
          <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\NUMA Control\Installer" Name="Shortcuts" Value="1" Type="integer" KeyPath="yes" />
          <RegistryValue Root="HKCU" Key="Software\NUMA Control\Installer" Name="MenuFolder" Value="[APPLICATIONMENUFOLDER]" Type="string" />
        </Component>
        <Component Id="StandaloneUninstallShortcut" Guid="2F077EAB-D504-4616-B66A-299559425DC8" Condition="NOT ARPSYSTEMCOMPONENT" Bitness="always64">

          <Shortcut Id="StartMenuUninstall" Name="Удалить NUMA Control" Target="[System64Folder]msiexec.exe" Arguments="/x [ProductCode]" Description="Удалить программу. Пользовательские профили сохранятся" />
          <RemoveFolder Id="RemoveStandaloneMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\NUMA Control\Installer" Name="StandaloneUninstallShortcut" Value="1" Type="integer" KeyPath="yes" />
        </Component>
      </Directory></StandardDirectory>
      <StandardDirectory Id="DesktopFolder">
        <Component Id="DesktopShortcut" Guid="D22E229D-4745-40D6-9B12-4652805DD624" Condition="DESKTOPCHOICE = &quot;1&quot;" Bitness="always64">

          <Shortcut Id="DesktopLaunch" Name="NUMA Control" Target="[INSTALLFOLDER]NUMA-Control.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" Description="Открыть NUMA Control" />
          <RegistryValue Root="HKCU" Key="Software\NUMA Control\Installer" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
        </Component>
      </StandardDirectory>
    </Package>
</Wix>
