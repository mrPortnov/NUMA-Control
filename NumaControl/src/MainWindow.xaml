<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:NumaControl;assembly=UI_ASSEMBLY" Title="NUMA Control" Width="1220" Height="870" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="242"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#151820" BorderBrush="#282D39" BorderThickness="0,0,1,0">
      <Grid Margin="18,24,18,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="10,0,0,30">
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource AppMark}" Width="35" Height="35" Margin="0,0,11,0"/>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="NUMA" FontSize="18" FontWeight="Bold"/><TextBlock Text="C O N T R O L" FontSize="10" Foreground="#A7A0C7"/></StackPanel>
          </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1" Margin="10,0,6,10"><TextBlock Text="ИГРОВЫЕ ПРОФИЛИ" FontSize="11" FontWeight="SemiBold" Foreground="#7D879C"/><TextBlock x:Name="GameCount" HorizontalAlignment="Right" FontSize="11" Foreground="#7D879C"/></Grid>
        <DockPanel Grid.Row="2">
          <Button x:Name="AddGame" DockPanel.Dock="Bottom" Content="＋  Добавить игру" Margin="0,12,0,20"/>
          <ListBox x:Name="GameList">
            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="36" CornerRadius="7" Background="#32303D" VerticalAlignment="Center"><Grid><Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="{Binding Badge}" Foreground="{Binding Brush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <StackPanel Grid.Row="3">
          <Border Height="1" Background="#2A2F3B" Margin="0,0,0,12"/>
          <Button x:Name="LibraryNav" Style="{StaticResource Quiet}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource NavLibrary}" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Библиотека"/></StackPanel></Button>
          <Button x:Name="SettingsNav" Style="{StaticResource Quiet}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource NavSettings}" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Настройки"/></StackPanel></Button>
          <Button x:Name="LogNav" Style="{StaticResource Quiet}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource NavLog}" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Журнал событий"/></StackPanel></Button>
          <Button x:Name="DiagnosticsNav" Style="{StaticResource Quiet}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource NavHealth}" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Самодиагностика"/></StackPanel></Button>
          <Border x:Name="EngineBadge" Background="#1D2429" CornerRadius="9" Padding="12" Margin="0,18,0,0"><TextBlock x:Name="EngineLabel" Text="●  Наблюдение активно" Foreground="#8ED9B7" FontSize="12"/></Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,27,30,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PageTitle" Text="Твоя игра. Твои ядра." FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Управляй привязкой игр — остальное под контролем." Foreground="#949DB1" Margin="0,7,0,0" FontSize="13"/></StackPanel><Button x:Name="PauseAll" Content="Ⅱ  Пауза" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
      <ScrollViewer x:Name="LibraryView" Grid.Row="1">
        <StackPanel Margin="0,0,8,0">
          <Grid x:Name="SummaryCards" Grid.IsSharedSizeScope="True" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="20" SharedSizeGroup="SummaryOuter"/><RowDefinition Height="*" MinHeight="32"/><RowDefinition Height="Auto" MinHeight="20" SharedSizeGroup="SummaryOuter"/></Grid.RowDefinitions><ui:OpticalText Text="НАБЛЮДАТЕЛИ" FontSize="10" Foreground="#949DB1" VerticalAlignment="Center"/><Grid Grid.Row="1"><ui:OpticalText x:Name="ObserverMetric" Text="—" Style="{StaticResource SummaryMetric}"/></Grid><ui:OpticalText x:Name="ObserverHint" Grid.Row="2" Text="ожидают запуск игры" Foreground="#949DB1" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="IntervalHint" Visibility="Collapsed"/></Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="20" SharedSizeGroup="SummaryOuter"/><RowDefinition Height="*" MinHeight="32"/><RowDefinition Height="Auto" MinHeight="20" SharedSizeGroup="SummaryOuter"/></Grid.RowDefinitions><ui:OpticalText Text="ПРОЦЕССОР" FontSize="10" Foreground="#949DB1" VerticalAlignment="Center"/><Grid Grid.Row="1"><ui:OpticalText x:Name="CpuMetric" Text="—" Style="{StaticResource SummaryMetric}"/></Grid><ui:OpticalText x:Name="CpuHint" Grid.Row="2" Text="Определение процессора…" Foreground="#949DB1" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="20" SharedSizeGroup="SummaryOuter"/><RowDefinition Height="*" MinHeight="32"/><RowDefinition Height="Auto" MinHeight="20" SharedSizeGroup="SummaryOuter"/></Grid.RowDefinitions><ui:OpticalText Text="ЯДРА ДЛЯ РАБОТЫ КОНТРОЛЛЕРА" FontSize="10" Foreground="#949DB1" VerticalAlignment="Center" TextWrapping="Wrap"/><Grid Grid.Row="1"><ui:OpticalText x:Name="AppCoreMetric" Text="Авто" Style="{StaticResource SummaryMetric}" Foreground="#9DD8BF"/></Grid><ui:OpticalText x:Name="AppCoreHint" Grid.Row="2" Text="ожидание проверки" Foreground="#949DB1" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border>
          </Grid>
          <Border x:Name="LegacyBanner" Background="#30291D" BorderBrush="#655336" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16" Visibility="Collapsed"><TextBlock x:Name="LegacyText" TextWrapping="Wrap" Foreground="#E9CFA0" FontSize="12"/></Border>
          <Border x:Name="EmptyState" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="Здесь будет твоя библиотека" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Добавь игру по EXE или выбери её среди запущенных процессов." Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border>
          <StackPanel x:Name="ProfilePanel">
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock x:Name="SelectedGameCaption" Text="ВЫБРАННАЯ ИГРА" Style="{StaticResource SectionHeading}"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="9" Background="#292D3C" Margin="0,0,12,0"><Grid><Image x:Name="SelectedGameIcon" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock x:Name="SelectedGameBadge" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="SelectedName" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SelectedProcess" Foreground="#949DB1" FontFamily="Consolas" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></StackPanel><CheckBox x:Name="EnabledToggle" Grid.Column="1" Style="{StaticResource Switch}" Content="Следить" VerticalAlignment="Top" Margin="0,9,0,0"/></Grid>
                <Border Background="#111B1B" CornerRadius="8" Padding="12" Margin="0,18,0,0"><StackPanel><TextBlock x:Name="LiveState" Text="Ожидание игры" Foreground="#9DD8BF" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="LiveDetail" TextWrapping="Wrap" Foreground="#8FA4A1" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
                <WrapPanel Margin="0,16,0,0"><Button x:Name="LaunchGame" Style="{StaticResource Primary}" Content="▷  Запустить игру" Margin="0,0,8,0"/><Button x:Name="DesktopShortcut" Content="↗  Ярлык на рабочий стол" Margin="0,0,8,0"/><Button x:Name="EditGame" Content="Параметры"/></WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Margin="0,0,12,0">
                  <StackPanel Orientation="Horizontal">
                    <ui:BaselinePanel UseLayoutRounding="False" SnapsToDevicePixels="False" VerticalAlignment="Center">
                      <TextBlock x:Name="CpuMapTitle" Text="КАРТА ПРОЦЕССОРА" Style="{StaticResource SectionHeading}"/>
                      <TextBlock x:Name="MaskLabel" FontFamily="Consolas" FontSize="15" FontWeight="{Binding FontWeight, ElementName=CpuMapTitle}" Foreground="#B6AFFF" Margin="12,0,0,0"/>
                    </ui:BaselinePanel>
                    <Border x:Name="CpuModeInfo" Width="22" Height="22" CornerRadius="11" Margin="10,0,0,0"
                            Background="#252A37" BorderThickness="1" Focusable="True" Cursor="Help"
                            ToolTipService.ShowDuration="24000" ToolTipService.ShowsToolTipOnKeyboardFocus="True">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="BorderBrush" Value="#343A4B"/>
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#B6AFFF"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#B6AFFF"/></Trigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Border.ToolTip>
                        <ToolTip Placement="Bottom" VerticalOffset="6" HasDropShadow="True" FontFamily="Segoe UI">
                          <ToolTip.Template>
                            <ControlTemplate TargetType="ToolTip">
                              <Border Background="#191C25" BorderBrush="#B6AFFF" BorderThickness="1" CornerRadius="10" Padding="14">
                                <ContentPresenter/>
                              </Border>
                            </ControlTemplate>
                          </ToolTip.Template>
                          <StackPanel Width="300">
                            <TextBlock Text="{Binding}" Foreground="#B6AFFF" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock Text="Жёсткая маска ограничивает, на каких ЦП процесс может выполняться."
                                       Foreground="#EEF0F8" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="CPU Sets задаёт набор ЦП по умолчанию для потоков без собственного назначения. В Диспетчере задач при этом могут отображаться все ЦП."
                                       Foreground="#EEF0F8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                          </StackPanel>
                        </ToolTip>
                      </Border.ToolTip>
                      <TextBlock Text="i" Foreground="#B6AFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="ProcessorName" Foreground="#949DB1" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <WrapPanel Margin="0,17,0,12"><Button x:Name="PresetAll" Content="Все ЦП" Padding="10,7" Margin="0,0,7,7"/><Button x:Name="PresetEdges" Content="Без крайних ядер" Padding="10,7" Margin="0,0,7,7" ToolTip="Исключить первое и последнее физическое ядро со всеми SMT-потоками"/><Button x:Name="PresetPhysical" Content="По главному потоку на ядро" Padding="10,7" Margin="0,0,0,7" ToolTip="Первый логический поток каждого физического ядра по нумерации Windows. Производительность SMT-соседей не ранжируется."/></WrapPanel>
                <WrapPanel x:Name="CpuMap" Margin="-5,0,0,0"/>
                <TextBlock Text="Нажимайте на потоки, чтобы собрать свою привязку для игры. Можно выбрать любую комбинацию ядер и потоков." Foreground="#8993A9" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <Border Height="1" Background="#2A2F3C" Margin="0,18,0,16"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectionHint" VerticalAlignment="Center" Foreground="#949DB1" FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0"/><Button x:Name="SaveMask" Grid.Column="1" Content="Сохранить привязку" Style="{StaticResource Primary}" HorizontalAlignment="Right"/></Grid>
              </StackPanel>
            </Border>
            <TextBlock Text="Правила привязки применяются во время наблюдения. Назначенная маска сохраняется до завершения процесса игры." Foreground="#747F95" FontSize="11" TextWrapping="Wrap" Margin="3,15,3,20"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed"><StackPanel x:Name="SettingsBody" Margin="0,0,8,12"/></ScrollViewer>
      <ScrollViewer x:Name="DiagnosticsView" Grid.Row="1" Visibility="Collapsed"><StackPanel x:Name="DiagnosticsBody" Margin="0,0,8,12"/></ScrollViewer>
      <Grid x:Name="LogView" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><Button x:Name="RefreshLog" DockPanel.Dock="Right" Content="Обновить"/><TextBlock Text="Последние 250 записей · новые сверху" Foreground="#949DB1" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></Grid>
      <Grid Grid.Row="2" Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Toast" Text="" Foreground="#7F899D" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
        <TextBlock x:Name="VersionLabel" Grid.Column="1" Foreground="#7F899D" FontSize="10"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
